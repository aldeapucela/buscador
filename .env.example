# NocoDB: tabla "Log grupo" (log completo del chat de Telegram).
# La URL base y el token están hoy en la credencial "NocoDB Token account" de n8n.
NOCODB_URL=https://nocodb.ejemplo.org
NOCODB_TOKEN=
# ID de la tabla "Log grupo" (se ve en la URL de NocoDB: /table/{id})
NOCODB_TABLE=

# Sal para hashear los user_id de Telegram (HMAC). Genera una y no la cambies:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AUTHOR_HASH_SECRET=

# Clave que usará n8n para llamar a /search?scope=group, /forget y /reindex
API_KEY=
